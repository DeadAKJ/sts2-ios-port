<Project Sdk="Godot.NET.Sdk/4.5.2">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>STS2iOS</AssemblyName>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <UseSharedCompilation>false</UseSharedCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="sts2" />
    <TrimmerRootAssembly Include="GodotSharp" />
    <TrimmerRootAssembly Include="$(TargetName)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(MSBuildThisFileDirectory)lib/sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildThisFileDirectory)lib/0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MonoMod.Backports">
      <HintPath>$(MSBuildThisFileDirectory)lib/MonoMod.Backports.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MonoMod.ILHelpers">
      <HintPath>$(MSBuildThisFileDirectory)lib/MonoMod.ILHelpers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Steamworks.NET">
      <HintPath>$(MSBuildThisFileDirectory)lib/Steamworks.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Sentry">
      <HintPath>$(MSBuildThisFileDirectory)lib/Sentry.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SmartFormat">
      <HintPath>$(MSBuildThisFileDirectory)lib/SmartFormat.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SmartFormat.ZString">
      <HintPath>$(MSBuildThisFileDirectory)lib/SmartFormat.ZString.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Vortice.DXGI">
      <HintPath>$(MSBuildThisFileDirectory)lib/Vortice.DXGI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Vortice.DirectX">
      <HintPath>$(MSBuildThisFileDirectory)lib/Vortice.DirectX.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Vortice.Mathematics">
      <HintPath>$(MSBuildThisFileDirectory)lib/Vortice.Mathematics.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpGen.Runtime">
      <HintPath>$(MSBuildThisFileDirectory)lib/SharpGen.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpGen.Runtime.COM">
      <HintPath>$(MSBuildThisFileDirectory)lib/SharpGen.Runtime.COM.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.IO.Hashing">
      <HintPath>$(MSBuildThisFileDirectory)lib/System.IO.Hashing.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
